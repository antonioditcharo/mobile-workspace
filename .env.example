# Copy to .env and fill in. Every setting in config.json can be set this way:
# POKEFLIP_<SECTION>__<KEY>, uppercase, double underscore for nesting.

# --- price source -------------------------------------------------------
POKEFLIP_PROVIDER__NAME=pokemontcg
# Optional; raises the pokemontcg.io rate limit.
POKEFLIP_PROVIDER__API_KEY=

# For eBay prices (real sold data and velocity), keep pokemontcg as catalog:
# POKEFLIP_PROVIDER__NAME=ebay
# POKEFLIP_PROVIDER__CATALOG_NAME=pokemontcg
# POKEFLIP_PROVIDER__EBAY_CLIENT_ID=
# POKEFLIP_PROVIDER__EBAY_CLIENT_SECRET=

# --- what to track ------------------------------------------------------
POKEFLIP_TRACKED_SETS=sv3pt5
POKEFLIP_SCHEDULE__REFRESH_INTERVAL_MINUTES=360
POKEFLIP_SCHEDULE__DIGEST_HOUR=8
POKEFLIP_TIMEZONE=UTC

# --- your economics -----------------------------------------------------
# TCGplayer is 0.1025; eBay is nearer 0.1325.
POKEFLIP_FEES__COMMISSION_PCT=0.1025
POKEFLIP_FEES__SHIPPING_COST=1.10
POKEFLIP_BUY__MIN_ROI=0.25
POKEFLIP_SELL__TARGET_ROI=0.35
# Set this to get free-capital tracking and concentration warnings.
POKEFLIP_CAPITAL__BANKROLL=0

# --- delivery -----------------------------------------------------------
# Any of: console, file, webhook, slack, discord, email, ntfy, pushover, telegram
POKEFLIP_NOTIFY__CHANNELS=file,ntfy

# ntfy needs no account. Use a long random topic - anyone who knows it can
# read your alerts.
POKEFLIP_NOTIFY__NTFY_TOPIC=
# POKEFLIP_NOTIFY__NTFY_SERVER=https://ntfy.sh

# POKEFLIP_NOTIFY__PUSHOVER_TOKEN=
# POKEFLIP_NOTIFY__PUSHOVER_USER=

# Telegram also gives you /scan and /portfolio from your phone.
# POKEFLIP_NOTIFY__TELEGRAM_BOT_TOKEN=
# POKEFLIP_NOTIFY__TELEGRAM_CHAT_ID=

POKEFLIP_NOTIFY__PUSH_MIN_SEVERITY=warn
POKEFLIP_NOTIFY__QUIET_HOURS_START=22
POKEFLIP_NOTIFY__QUIET_HOURS_END=7

# --- exposing the server ------------------------------------------------
# Needed for one-tap buttons on notifications: your phone must be able to
# reach this URL. Put TLS in front of it.
POKEFLIP_SERVER__PUBLIC_BASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this before exposing the server to anything but localhost.
POKEFLIP_SERVER__API_TOKEN=
