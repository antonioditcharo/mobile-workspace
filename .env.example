# ---------------------------------------------------------------------------
# Backend: "hf" (Hugging Face) or "custom" (an endpoint you control)
# ---------------------------------------------------------------------------
PROVIDER=hf

# Hugging Face access token.
# Create at https://huggingface.co/settings/tokens with the
# "Make calls to Inference Providers" permission enabled.
HF_TOKEN=

DEFAULT_MODEL=Wan-AI/Wan2.2-T2V-A14B

# Which partner provider serves the model. "auto" looks it up on the Hub and
# routes accordingly — video models run on fal-ai, replicate or novita, never
# on hf-inference. Set a name here to force one.
HF_PROVIDER=auto

# ---------------------------------------------------------------------------
# Custom endpoint — your own weights, your own hardware.
# Used when PROVIDER=custom. Nothing sits between you and the model here.
#
# For free unlimited generation on your own NVIDIA card, run the server in
# local/ (double-click local/start-local-gpu.bat) and set:
#   PROVIDER=custom
#   CUSTOM_ENDPOINT=http://localhost:8000/generate
# See local/README.md.
#
# Also works with a ComfyUI wrapper, a rented GPU box, or a dedicated HF
# Inference Endpoint.
# ---------------------------------------------------------------------------
CUSTOM_ENDPOINT=
CUSTOM_AUTH_HEADER=Authorization
CUSTOM_AUTH_VALUE=

# Optional. Reshape the request body if your endpoint expects a different
# schema. Placeholders: {{prompt}} {{negative_prompt}} {{model}}
# Example: {"text":"{{prompt}}","avoid":"{{negative_prompt}}","steps":30}
CUSTOM_BODY_TEMPLATE=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
OUTPUT_DIR=outputs
MAX_CONCURRENT=1
JOB_TIMEOUT_MS=900000
RETAIN_JOBS=100
